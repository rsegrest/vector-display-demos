{
  "name": "vector-demos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Generative, artificial-life and 3D demos built on the @vector-display packages.",
  "workspaces": [
    "packages/*",
    "demos/*",
    "site"
  ],
  "scripts": {
    "dev": "npm run dev -w @vector-demos/site",
    "build": "npm run build:arcade && npm run build -w @vector-demos/site",
    "build:arcade": "node tools/build-arcade.mjs",
    "preview": "npm run preview -w @vector-demos/site",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "screenshot": "node tools/screenshot.mjs",
    "publish:globe": "node tools/publish-globe.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}

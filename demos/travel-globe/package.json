{
  "name": "@vector-demos/travel-globe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rick's travel map as a multicolor vector globe: visited countries and US states hatched in status colors.",
  "exports": {
    ".": "./src/index.ts",
    "./geo": "./src/geo/index.ts",
    "./geo.json": "./src/data/geo.json"
  },
  "scripts": {
    "build:geo": "node tools/build-geo.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "import:travel": "node tools/import-travel.mjs",
    "build:standalone": "vite build --config standalone/vite.config.ts"
  },
  "dependencies": {
    "@vector-demos/demo-kit": "*",
    "@vector-display/core": "^0.1.0"
  },
  "devDependencies": {
    "i18n-iso-countries": "7.14.0",
    "topojson-client": "3.1.0",
    "us-atlas": "3.0.1",
    "world-atlas": "2.0.2"
  }
}
